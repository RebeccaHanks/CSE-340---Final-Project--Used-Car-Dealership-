<h1>Dashboard</h1>

<p>Welcome <%= account.first_name %>!</p>

<p>Email: <%= account.email %></p>

<p>Role: <%= account.role %></p>

<% if (account.role === 'employee' || account.role === 'owner') { %>
  <p>
    <a href="/vehicles/manage">Manage Vehicles</a>
  </p>
<% } %>

<% if (account.role === 'owner') { %>
  <p>
    <a href="/account/manage">Manage Accounts</a>
  </p>
<% } %>

<p>
  <a href="/account/logout">Logout</a>
</p>