<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

<header>
  <h1>Hanks Auto Sales</h1>

  <nav>
    <a href="/">Home</a>
    <a href="/vehicles">Vehicles</a>

    <% if (account) { %>
      <a href="/service">Service Requests</a>
      <a href="/account/dashboard">Dashboard</a>

      <% if (
        account.role === 'employee' ||
        account.role === 'owner'
      ) { %>
        <a href="/vehicles/manage">Manage Vehicles</a>
      <% } %>

      <a href="/account/logout">Logout</a>
    <% } else { %>
      <a href="/account/login">Login</a>
      <a href="/account/register">Register</a>
    <% } %>
  </nav>
</header>
<h1>Edit Vehicle</h1>

<form action="/vehicles/edit/<%= vehicle.vehicle_id %>" method="POST">
  <label>Category</label>
  <select name="category_id" required>
    <% categories.forEach(category => { %>
      <option 
        value="<%= category.category_id %>"
        <%= category.category_id === vehicle.category_id ? 'selected' : '' %>>
        <%= category.category_name %>
      </option>
    <% }) %>
  </select>

  <label>Year</label>
  <input type="number" name="year" value="<%= vehicle.year %>" required>

  <label>Make</label>
  <input type="text" name="make" value="<%= vehicle.make %>" required>

  <label>Model</label>
  <input type="text" name="model" value="<%= vehicle.model %>" required>

  <label>Price</label>
  <input type="number" name="price" value="<%= vehicle.price %>" required>

  <label>Mileage</label>
  <input type="number" name="mileage" value="<%= vehicle.mileage %>" required>

  <label>Color</label>
  <input type="text" name="color" value="<%= vehicle.color %>">

  <label>Description</label>
  <textarea name="description"><%= vehicle.description %></textarea>

  <label>Image URL</label>
  <input type="text" name="image_url" value="<%= vehicle.image_url %>">

  <button type="submit">Save Changes</button>
</form>